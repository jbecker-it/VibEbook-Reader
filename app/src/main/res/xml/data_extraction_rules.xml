<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules xmlns:tools="http://schemas.android.com/tools">
    <cloud-backup>
        <include domain="file" path="progress/" />
        <!-- Deliberately retain explicit book exclusion alongside the progress-only allowlist. -->
        <exclude domain="file" path="books/" tools:ignore="FullBackupContent" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="progress/" />
    </device-transfer>
</data-extraction-rules>
